# Wardriving rig configuration
# Copy this file to config/rig.conf and edit before running install.sh.
# install.sh will auto-copy it on first run if rig.conf doesn't exist yet,
# then STOP and ask you to review it (passphrase especially) before continuing.

# --- Access point the Pi hosts (Tesla + your phone/laptop join this) ---
AP_SSID="WarDriving"
AP_PASSPHRASE="ChangeThisPassphrase123"   # WPA2-PSK, 8-63 chars. Change this.
AP_CHANNEL_24="6"                          # 2.4GHz channel for the AP
AP_COUNTRY="GB"

# Stable interface names assigned by udev (see udev/99-wardriving.rules).
# Do not point these at wlan0/wlan1 directly - USB enumeration order is not
# guaranteed across reboots, so we rename by driver/vendor instead.
AP_INTERFACE="wlan_ap"     # onboard Pi5 Wi-Fi (brcmfmac) - hosts the AP
MON_INTERFACE="wlan_mon"   # Alfa AWUS036AXML (mt7921u) - wardriving capture

# --- AP subnet / DHCP ---
AP_IP="192.168.3.1"
AP_PREFIX="24"
AP_SUBNET="192.168.3.0/24"
DHCP_RANGE_START="192.168.3.10"
DHCP_RANGE_END="192.168.3.200"
DHCP_LEASE_TIME="12h"

# --- GPS (Vk-162 USB GPS, u-blox 7) ---
# install.sh writes a udev rule that symlinks the VK-162 to this path
# regardless of which /dev/ttyACMx it enumerates as.
GPS_DEVICE="/dev/gps0"
GPS_BAUD="9600"

# BLE capture (WCH BLE Analyzer Pro) is handled entirely by the vendored
# stats-gui/ (WirelessBOSS) install - it builds and runs its own libusb
# driver for the analyzer, no config needed here.

# --- Kismet ---
# install.sh keeps this in sync with wherever the stats GUI (WirelessBOSS)
# actually writes its captures, so /export and its own dashboard agree on
# one directory - a hand-edit here gets overwritten on the next install.sh run.
KISMET_LOG_DIR="/home/pi/captures"
KISMET_HTTP_PORT="2501"

# --- Web launcher ---
WEB_HTTP_PORT="80"
WEB_APP_PORT="8090"          # internal gunicorn port, proxied by nginx
STATS_GUI_PORT="8080"        # WirelessBOSS's own web port (see stats-gui/)

# --- Desktop viewer (noVNC) ---
NOVNC_PORT="6080"
VNC_DISPLAY_NUM="1"          # :1
VNC_PORT="5901"
VNC_PASSWORD="ChangeThisVncPw"  # used to set the x11vnc password on first run

# --- Misc ---
RIG_USER="pi"                 # the non-root user everything runs as
INSTALL_DIR="/opt/wardriving-rig"
