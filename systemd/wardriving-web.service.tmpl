[Unit]
Description=Wardriving launcher web UI (gunicorn)
After=network.target

[Service]
Type=simple
User=${RIG_USER}
EnvironmentFile=/etc/wardriving-rig.env
WorkingDirectory=/opt/wardriving-rig/webapp
# gunicorn's default (sync) worker model fully blocks per request. With
# only 2 workers, the /stats page's own background polls (4 Kismet-backed
# endpoints every 5s, each with a 5-8s timeout in kismet_client.py) could
# occupy both workers at once, leaving nothing free to serve a fresh page
# load until one freed up - observed as several-second page load stalls.
# 6 workers gives generous headroom on a Pi 5 dedicated to this one job
# and otherwise mostly idle (4 cores, 8GB RAM).
ExecStart=/opt/wardriving-rig/webapp/.venv/bin/gunicorn -w 6 -b 127.0.0.1:${WEB_APP_PORT} app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
