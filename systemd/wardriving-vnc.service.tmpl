[Unit]
Description=x11vnc server for touchscreen desktop access
After=graphical.target

[Service]
Type=simple
User=${RIG_USER}
EnvironmentFile=/opt/wardriving-rig/config/rig.conf
ExecStart=/usr/bin/x11vnc -display :${VNC_DISPLAY_NUM} -rfbport ${VNC_PORT} -auth guess -forever -shared -noxdamage -passwdfile /opt/wardriving-rig/config/vncpasswd
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
