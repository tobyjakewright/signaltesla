# Rendered from rig.conf by scripts/render-configs.sh into
# /etc/kismet/kismet_site.conf (auto-included by the packaged kismet.conf).
# Edit config/rig.conf and re-run install.sh rather than hand-editing this.

# Wi-Fi wardriving capture source - the Alfa AWUS036AXML, pinned to the
# stable name wlan_mon by udev/10-wardriving-mon.link. Kismet puts this
# into monitor mode itself; no separate airmon-ng step needed.
source=${MON_INTERFACE}:name=wifi_wardriving

# BLE capture source. This assumes the WCH BLE Analyzer Pro enumerates as
# a standard Bluetooth HCI adapter - verify with `hciconfig -a` after
# plugging it in and correct BLE_HCI in rig.conf if it comes up as
# something other than hci0. See README "BLE sniffer caveats" if it
# doesn't show up as an HCI device at all.
source=${BLE_HCI}:name=ble_wardriving,type=linuxbluetooth

# GPS via gpsd (fed by the VK-162 over ${GPS_DEVICE}) so every Wi-Fi and
# BLE hit gets tagged with lat/lon.
gps=gpsd:host=localhost,port=2947,reconnect=true

# Logging - pcapng + kismet db, GPS-tagged, one set of files per run.
log_prefix=${KISMET_LOG_DIR}/
log_types=kismet,pcapng
log_title=wardriving

# Web UI
httpd_bind_address=0.0.0.0
httpd_port=${KISMET_HTTP_PORT}
