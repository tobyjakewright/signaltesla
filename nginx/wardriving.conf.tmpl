# Rendered from rig.conf into /etc/nginx/sites-available/wardriving
# Everything is served by the Flask launcher app; Kismet (2501) and noVNC
# (6080) are reached directly by IP:port from the pages it renders, so
# nginx only needs to front the launcher itself on port 80.
server {
    listen ${WEB_HTTP_PORT} default_server;
    listen [::]:${WEB_HTTP_PORT} default_server;
    server_name _;

    location / {
        proxy_pass http://127.0.0.1:${WEB_APP_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
